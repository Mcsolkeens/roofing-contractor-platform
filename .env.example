# RoofPitch environment variables
# Copy this file to `.env.local` and fill in what you need.
# Everything defaults to local "mock/console/memory" providers, so the app runs
# with NO keys set. Add real keys only when you want to hit real services.

# ----- Which provider to use for each concern -----
# measurement: mock | eagleview
MEASUREMENT_PROVIDER=mock
# email: console | resend
EMAIL_PROVIDER=console
# payment: mock | stripe
PAYMENT_PROVIDER=mock
# storage: memory | s3
STORAGE_PROVIDER=memory

# ----- EagleView (measurement) -----
# Option A: static API key
# EAGLEVIEW_API_KEY=
# Option B: OAuth2 client credentials (used if API key is absent)
# NEVER commit real credentials here - this file is tracked in git.
# EAGLEVIEW_CLIENT_ID=your-okta-client-id
# EAGLEVIEW_CLIENT_SECRET=your-okta-client-secret
# Token host is the API Center host in both sandbox and production.
# EAGLEVIEW_TOKEN_URL=https://apicenter.eagleview.com/oauth2/v1/token
# EAGLEVIEW_API_BASE=https://apicenter.eagleview.com
# EAGLEVIEW_TIMEOUT_MS=20000

# ----- Resend (email) -----
# RESEND_API_KEY=
# EMAIL_FROM=RoofPitch <noreply@roofpitch.ca>

# ----- Stripe (payment) -----
# STRIPE_SECRET_KEY=

# ----- Data layer -----
# DATA_DRIVER: memory | aurora | postgres
#   memory  -> in-process store (default; great for local UI testing, resets on restart)
#   postgres-> plain Postgres via DATABASE_URL (local Docker Postgres)
#   aurora  -> Amazon Aurora PostgreSQL via IAM (works on Vercel with the integration)
DATA_DRIVER=memory

# Plain Postgres (DATA_DRIVER=postgres)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roofpitch

# Aurora IAM (DATA_DRIVER=aurora) — provided automatically by the Vercel integration:
# PGHOST=, PGUSER=, PGDATABASE=, AWS_REGION=, AWS_ROLE_ARN=

# ----- Admin dashboard -----
ADMIN_PASSWORD=roofpitch-admin
# Token to authorize running /api/admin/migrate (schema setup)
MIGRATE_TOKEN=dev-migrate

# ----- Cron (job poller) -----
# Vercel Cron calls /api/cron/poll-jobs on a schedule (see vercel.json) and
# automatically sends `Authorization: Bearer $CRON_SECRET`. Set this in the
# Vercel project so the endpoint can't be triggered publicly. If unset (local
# dev), the poller runs without auth so you can test it with a plain request.
# CRON_SECRET=
